@echo off
chcp 65001 >nul
title Islam AI ReelForge
cls
echo ===============================================================================
echo                🎬 مرحباً بك في Islam AI ReelForge
echo          محرك مونتاج الريلز والفيديوهات الذكي بنقرة واحدة
echo ===============================================================================
echo.
echo اسحب وأفلت ملف الفيديو هنا (أو الصق مسار الفيديو)، ثم اضغط Enter:
set /p VIDEO_PATH="المسار: "

if "%VIDEO_PATH%"=="" (
    echo [X] لم يتم تحديد ملف!
    pause
    exit /b 1
)

:: Remove quotes if any
set VIDEO_PATH=%VIDEO_PATH:"=%

echo.
echo [1/3] جاري فحص بيئة التشغيل وتجهيز المحرك...
python reelforge.py "%VIDEO_PATH%" --capcut

echo.
echo ===============================================================================
echo [V] تم الانتهاء بنجاح! ستجد الفيديو النهائي ومستند المشروع في مجلد workspace_reel
echo ===============================================================================
pause
